# Copy to .env.local and fill in. Never commit real values.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiry emails are delivered (the owner's inbox)
CONTACT_TO_EMAIL=

# Verified sender address, e.g. "Richmond Square <inquiries@therichmondsquare.com>"
# The domain must be verified in Resend before production sends will work.
CONTACT_FROM_EMAIL=
